# $NetBSD$

DISTNAME=	akvorado-${GITHUB_TAG}
PKGNAME=	akvorado-2026.10.1.20261104
CATEGORIES=	net
MASTER_SITES=	${MASTER_SITE_GITHUB:=akvorado/}
GITHUB_PROJECT=	akvorado
GITHUB_TAG=	472d8382d88e61f5181c13880b02e2808480075c

MAINTAINER=	cleber@bsd.com.br
HOMEPAGE=	https://github.com/akvorado/akvorado
COMMENT=	Flow collector, enricher and visualizer
LICENSE=	gnu-agpl-v3

# Files generated by "make all-indep" upstream (embedded web console,
# generated Go code, ClickHouse data), packed with the akvorado-<commit>/
# prefix so they extract straight into WRKSRC.
AKVORADO_ASSETS=	akvorado-${PKGVERSION_NOREV}-generated-assets.tar.gz
DISTFILES=		${DEFAULT_DISTFILES} ${AKVORADO_ASSETS}
SITES.${AKVORADO_ASSETS}= \
	https://github.com/cleberalves40/akvorado/releases/download/bsd-distfiles-${PKGVERSION_NOREV}/
EXTRACT_ONLY=		${DEFAULT_DISTFILES} ${AKVORADO_ASSETS} ${GO_MODULE_EXTRACT}

# modernc.org/libc (pulled by the SQLite driver) only supports amd64 on NetBSD.
NOT_FOR_PLATFORM=	NetBSD-*-i386 NetBSD-*-earm* NetBSD-*-aarch64*

GO_VERSION_REQD=	127
PKG_SYSCONFSUBDIR=	akvorado
EGDIR=			${PREFIX}/share/examples/akvorado

AKVORADO_USER?=		akvorado
AKVORADO_GROUP?=	akvorado
PKG_GROUPS=		${AKVORADO_GROUP}
PKG_USERS=		${AKVORADO_USER}:${AKVORADO_GROUP}
PKG_GECOS.${AKVORADO_USER}=	Akvorado daemon
PKG_GROUPS_VARS+=	AKVORADO_GROUP
PKG_USERS_VARS+=	AKVORADO_USER

RCD_SCRIPTS=		akvorado_orchestrator akvorado_inlet akvorado_outlet \
			akvorado_console
FILES_SUBST+=		AKVORADO_USER=${AKVORADO_USER}
MESSAGE_SUBST+=		EGDIR=${EGDIR}
OWN_DIRS_PERMS+=	${VARBASE}/log/akvorado ${AKVORADO_USER} ${AKVORADO_GROUP} 0755
OWN_DIRS_PERMS+=	${VARBASE}/run/akvorado ${AKVORADO_USER} ${AKVORADO_GROUP} 0755

.for config in akvorado.yaml console.yaml inlet.yaml outlet.yaml
CONF_FILES+=		${EGDIR}/${config} ${PKG_SYSCONFDIR}/${config}
.endfor

INSTALLATION_DIRS+=	bin share/doc/akvorado share/examples/akvorado
MAKE_ENV+=		GOTELEMETRY=off XDG_CONFIG_HOME=${WRKDIR}
AKVORADO_TAGS=		release,grpcnotrace,validator_novalidatefn
AKVORADO_LDFLAGS=	-s -w -X akvorado/common/helpers.AkvoradoVersion=${PKGVERSION_NOREV}

# The upstream sample configuration targets the Docker Compose setup. Adapt
# it to a single host: local Kafka/ClickHouse, one HTTP port per service,
# memory cache instead of Redis, one UDP worker per port (SO_REUSEPORT does
# not load-balance on the BSDs) and the GeoIP location used by pkgsrc.
SUBST_CLASSES+=		hosts
SUBST_STAGE.hosts=	pre-configure
SUBST_MESSAGE.hosts=	Adapting sample configuration to a single host.
SUBST_FILES.hosts=	config/akvorado.yaml
SUBST_SED.hosts=	-e 's|- kafka:9092|- 127.0.0.1:9092|'
SUBST_SED.hosts+=	-e 's|- clickhouse:9000|- 127.0.0.1:9000|'
SUBST_SED.hosts+=	-e 's|http://akvorado-orchestrator:8080|http://127.0.0.1:8080|'

SUBST_CLASSES+=		inlet
SUBST_STAGE.inlet=	pre-configure
SUBST_MESSAGE.inlet=	Using one UDP worker per listening port.
SUBST_FILES.inlet=	config/inlet.yaml
SUBST_SED.inlet=	-e 's|workers: 4|workers: 1|'

SUBST_CLASSES+=		geoip
SUBST_STAGE.geoip=	pre-configure
SUBST_MESSAGE.geoip=	Fixing GeoIP database location.
SUBST_FILES.geoip=	config/outlet.yaml
SUBST_SED.geoip=	-e 's|/usr/share/GeoIP|${PREFIX}/share/GeoIP|'

SUBST_CLASSES+=		console
SUBST_STAGE.console=	pre-configure
SUBST_MESSAGE.console=	Using the memory cache and a dedicated HTTP port.
SUBST_FILES.console=	config/console.yaml
SUBST_SED.console=	-e 's|^  cache:$$|  listen: :8083|'
SUBST_SED.console+=	-e '/^    type: redis$$/d'
SUBST_SED.console+=	-e '/^    server: redis:6379$$/d'

.include "go-modules.mk"

post-patch:
	${RUN} ${PRINTF} 'http:\n  listen: :8081\n' >> ${WRKSRC}/config/inlet.yaml
	${RUN} ${PRINTF} 'http:\n  listen: :8082\n' >> ${WRKSRC}/config/outlet.yaml

do-build:
	${RUN} ${MKDIR} ${WRKDIR}/.gopath/bin
	${RUN} cd ${WRKSRC} && ${PKGSRC_SETENV} ${MAKE_ENV} CGO_ENABLED=0 \
		${GO} build -trimpath -tags=${AKVORADO_TAGS} \
		-ldflags ${AKVORADO_LDFLAGS:Q} \
		-o ${WRKDIR}/.gopath/bin/akvorado ./cmd/akvorado
	${RUN} cd ${WRKSRC} && ${PKGSRC_SETENV} ${MAKE_ENV} CGO_ENABLED=0 \
		${GO} build -trimpath -tags=${AKVORADO_TAGS},akvorado_inlet \
		-ldflags ${AKVORADO_LDFLAGS:Q} \
		-o ${WRKDIR}/.gopath/bin/akvorado-inlet ./cmd/akvorado

post-install:
	${INSTALL_DATA} ${WRKSRC}/README.md ${DESTDIR}${PREFIX}/share/doc/akvorado/README.md
.for config in akvorado.yaml console.yaml inlet.yaml outlet.yaml
	${INSTALL_DATA} ${WRKSRC}/config/${config} ${DESTDIR}${EGDIR}/${config}
.endfor

.include "../../lang/go/go-module.mk"
.include "../../mk/bsd.pkg.mk"
