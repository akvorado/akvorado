#!/bin/sh

# PROVIDE: akvorado_outlet
# REQUIRE: NETWORKING akvorado_orchestrator
# KEYWORD: shutdown

. /etc/rc.subr

name=akvorado_outlet
rcvar=akvorado_outlet_enable

load_rc_config "$name"

: ${akvorado_outlet_enable:="NO"}
: ${akvorado_user:="%%AKVORADO_USER%%"}
: ${akvorado_orchestrator_url:="http://127.0.0.1:8080"}
: ${akvorado_outlet_pidfile:="/var/run/akvorado_outlet.pid"}

pidfile="${akvorado_outlet_pidfile}"
command="/usr/sbin/daemon"
procname="%%PREFIX%%/bin/akvorado"
command_args="-f -S -T ${name} -p ${pidfile} -u ${akvorado_user} ${procname} outlet ${akvorado_orchestrator_url}"

run_rc_command "$1"