#!/bin/sh

# PROVIDE: akvorado_console
# REQUIRE: NETWORKING akvorado_orchestrator
# KEYWORD: shutdown

. /etc/rc.subr

name=akvorado_console
rcvar=akvorado_console_enable

load_rc_config "$name"

: ${akvorado_console_enable:="NO"}
: ${akvorado_user:="%%AKVORADO_USER%%"}
: ${akvorado_orchestrator_url:="http://127.0.0.1:8080"}
: ${akvorado_console_pidfile:="/var/run/akvorado_console.pid"}

pidfile="${akvorado_console_pidfile}"
command="/usr/sbin/daemon"
procname="%%PREFIX%%/bin/akvorado"
command_args="-f -S -T ${name} -p ${pidfile} -u ${akvorado_user} ${procname} console ${akvorado_orchestrator_url}"

run_rc_command "$1"