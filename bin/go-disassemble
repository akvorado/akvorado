#!/bin/bash
# Disassemble a symbol of this package as Go assembly. Jump targets become
# labels and the source location becomes a comment.
#
# Usage:
#   ./go-disassemble <symbol-regexp>
#
# The package is built as a test binary, so tests and benchmarks are included.
# An inlined function keeps no symbol: disassemble a caller and read the
# file:line column to find it.
#
#   ./go-disassemble 'BenchmarkAddrTo6\.func[123]$'

set -eu

if [ $# -ne 1 ]; then
	echo "usage: $0 <symbol-regexp>" >&2
	exit 1
fi

log=$(mktemp)
trap 'rm -f "$log"' EXIT

# -S asks the compiler for the assembly it produces, on stderr
if ! go test -c -o /dev/null -gcflags=-S . >/dev/null 2>"$log"; then
	cat "$log" >&2
	exit 1
fi

re=$1 me=$0 awk -F'\t' '
BEGIN { re = ENVIRON["re"] }
# Last two components of a path, enough to tell files apart
function shorten(s, a, k) {
	k = split(s, a, "/")
	if (k < 2) return s
	return a[k-1] "/" a[k]
}
function flush(i, t, o) {
	if (kept == 0) { reset(); return }
	found = 1
	for (i = 1; i <= n; i++)
		if (keep[i] && (off[i] in tgt) && !(off[i] in lbl)) lbl[off[i]] = "L" ++c
	if (pkg != shown) { printf "\n%s\n", pkg; shown = pkg }
	printf "\n%s // %s\n", header, start
	for (i = 1; i <= n; i++) {
		if (!keep[i]) continue
		if (off[i] in lbl && !(off[i] in seen)) {
			seen[off[i]] = 1
			printf "%s:\n", lbl[off[i]]
		}
		o = ops[i]
		t = jump[i]
		if (t != "" && (t in lbl)) sub(/[0-9]+$/, lbl[t], o)
		printf "\t%-8s%-46s // %s\n", mnem[i], o, pos[i]
	}
	reset()
}
function reset() {
	n = 0; kept = 0; c = 0
	delete off; delete pos; delete mnem; delete ops
	delete keep; delete jump; delete tgt; delete lbl; delete seen
}
# A symbol, a package name or a compiler error starts at the first column
/^[^\t]/ {
	flush()
	if (/^#/) { pkg = $0; next }
	split($0, h, " ")
	take = (h[2] == "STEXT" && h[1] ~ re)
	header = $0
	next
}
# Keep the instructions, drop the relocations and the machine code dump
!take { next }
$2 !~ /^0x[0-9a-f]+ [0-9]+ \(/ { next }
{
	# The address column looks like "0x0012 00018 (file.go:42)"
	p = index($2, " ")
	rest = substr($2, p + 1)
	p = index(rest, " ")
	n++
	off[n] = substr(rest, 1, p - 1) + 0
	pos[n] = shorten(substr(rest, p + 2, length(rest) - p - 2))
	mnem[n] = $3
	ops[n] = $4
	# TEXT tells where the function starts, the rest is bookkeeping
	if ($3 == "TEXT") start = pos[n]
	keep[n] = ($3 != "TEXT" && $3 != "PCDATA" && $3 != "FUNCDATA")
	kept += keep[n]
	# A branch to a plain number jumps inside the function
	if (keep[n] && $3 ~ /^(J|B|CB|TB|LOOP)/ && $4 ~ /(^|, )[0-9]+$/) {
		t = $4
		sub(/^.*, /, "", t)
		tgt[t + 0] = 1
		jump[n] = t + 0
	}
}
END {
	flush()
	if (!found) {
		printf "%s: no symbol matches %s\n", ENVIRON["me"], re > "/dev/stderr"
		exit 1
	}
}' "$log"
