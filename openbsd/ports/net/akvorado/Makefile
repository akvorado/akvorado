COMMENT =		flow collector, enricher and visualizer

V =			2026.10.1.20261104
COMMIT =		472d8382d88e61f5181c13880b02e2808480075c
DISTNAME =		akvorado-${V}
CATEGORIES =		net

HOMEPAGE =		https://github.com/akvorado/akvorado

MAINTAINER =		Cleber Alves do Nascimento <cleber@bsd.com.br>

# AGPLv3
PERMIT_PACKAGE =	Yes

# modernc.org/libc (pulled by the SQLite driver) only supports these.
ONLY_FOR_ARCHS =	amd64 aarch64

MODULES =		lang/go

# The main module is named "akvorado", which is not fetchable from the Go
# proxy: fetch the main module from GitHub (the framework fetches
# ${SITES}${MODGO_VERSION}.zip) while dependencies come from modules.inc.
MODGO_MODNAME =		akvorado
MODGO_VERSION =		${COMMIT}
SITES =			https://github.com/akvorado/akvorado/archive/
WRKSRC =		${WRKDIR}/akvorado-${COMMIT}

# Files generated by "make all-indep" upstream (embedded web console,
# generated Go code, ClickHouse data), packed with the akvorado-<commit>/
# prefix so they extract straight into WRKSRC.
ASSETS =		akvorado-${V}-generated-assets.tar.gz
SITES.assets =		https://github.com/cleberalves40/akvorado/releases/download/bsd-distfiles-${V}/
DISTFILES.assets =	${ASSETS}
EXTRACT_ONLY +=		${ASSETS}

MAKE_ENV +=		CGO_ENABLED=0 GOTELEMETRY=off XDG_CONFIG_HOME=${WRKDIR}
MODGO_LDFLAGS +=	-X akvorado/common/helpers.AkvoradoVersion=${V}
AKVORADO_TAGS =		release,grpcnotrace,validator_novalidatefn

# The upstream sample configuration targets the Docker Compose setup. Adapt
# it to a single host: local Kafka/ClickHouse, one HTTP port per service,
# memory cache instead of Redis, one UDP worker per port (SO_REUSEPORT does
# not load-balance on OpenBSD) and the geoipupdate database directory.
post-patch:
	sed -i -e 's|- kafka:9092|- 127.0.0.1:9092|' \
		-e 's|- clickhouse:9000|- 127.0.0.1:9000|' \
		-e 's|http://akvorado-orchestrator:8080|http://127.0.0.1:8080|' \
		${WRKSRC}/config/akvorado.yaml
	sed -i -e 's|workers: 4|workers: 1|' ${WRKSRC}/config/inlet.yaml
	sed -i -e 's|/usr/share/GeoIP|/var/db/GeoIP|' \
		${WRKSRC}/config/outlet.yaml
	sed -i -e 's|^  cache:$$|  listen: :8083|' \
		-e '/^    type: redis$$/d' \
		-e '/^    server: redis:6379$$/d' \
		${WRKSRC}/config/console.yaml
	printf 'http:\n  listen: :8081\n' >> ${WRKSRC}/config/inlet.yaml
	printf 'http:\n  listen: :8082\n' >> ${WRKSRC}/config/outlet.yaml

do-build:
	mkdir -p ${MODGO_WORKSPACE}/bin
	cd ${WRKSRC} && ${MODGO_CMD} build ${MODGO_FLAGS} \
		-ldflags="${MODGO_LDFLAGS}" -tags=${AKVORADO_TAGS} \
		-o ${MODGO_WORKSPACE}/bin/akvorado ./cmd/akvorado
	cd ${WRKSRC} && ${MODGO_CMD} build ${MODGO_FLAGS} \
		-ldflags="${MODGO_LDFLAGS}" -tags=${AKVORADO_TAGS},akvorado_inlet \
		-o ${MODGO_WORKSPACE}/bin/akvorado-inlet ./cmd/akvorado

post-install:
	${INSTALL_DATA_DIR} ${PREFIX}/share/doc/akvorado
	${INSTALL_DATA} ${WRKSRC}/README.md ${PREFIX}/share/doc/akvorado/
	${INSTALL_DATA_DIR} ${PREFIX}/share/examples/akvorado
.for config in akvorado.yaml console.yaml inlet.yaml outlet.yaml
	${INSTALL_DATA} ${WRKSRC}/config/${config} \
		${PREFIX}/share/examples/akvorado/
.endfor

do-test:
	cd ${WRKSRC} && ${MODGO_CMD} test ${MODGO_FLAGS} \
		./inlet/flow/input/udp ./inlet/flow/input/sctp

.include "modules.inc"

.include <bsd.port.mk>
